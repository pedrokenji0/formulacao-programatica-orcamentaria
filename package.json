{
  "name": "formulacao-programatica-orcamentaria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:data": "node scripts/planning-import.mjs --exercicio 2026",
    "test:planning": "node --test scripts/planning.test.mjs scripts/project-maps.test.mjs",
    "test:project-maps": "node --test scripts/project-maps.test.mjs",
    "test:e2e": "playwright test",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "deploy:local": "npm run build && npm run preview:local",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:obz": "node --test scripts/obz-data.test.mjs",
    "test": "node --test scripts/planning.test.mjs scripts/project-maps.test.mjs scripts/obz-data.test.mjs scripts/data-integrity.test.mjs scripts/territory.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "generate:territory": "node scripts/territory-build.mjs",
    "update:territory": "node scripts/territory-source.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
